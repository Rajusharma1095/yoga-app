# Show DRAFT pose content in a production build.
#
# Content is DRAFT until the yoga therapist approves each row, and a production
# build refuses to render DRAFT rows — a real user would see an empty state.
# Set this to "true" only on a staging or demo deploy; the app then shows a
# loud amber banner on every screen saying the review is still pending.
#
# NEVER set this on the deploy real users visit.
NEXT_PUBLIC_ALLOW_DRAFT_CONTENT=false
